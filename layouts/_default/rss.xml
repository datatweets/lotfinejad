{{- /* RSS feed with Persian channel text (Hugo's built-in feed uses English
     "Recent content in … on …"). Home and /posts/ list the notes only. */ -}}
{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $title := cond .IsHome (printf "یادداشت‌های %s" site.Title) (printf "%s | %s" .Title site.Title) -}}
{{- $desc := cond .IsHome site.Params.description (.Description | default site.Params.description) -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $desc }}</description>
    <language>fa-IR</language>
    <managingEditor>{{ site.Params.email }} ({{ site.Params.author }})</managingEditor>
    {{- with $pages }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range first 20 $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Params.summary | default .Summary | plainify }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
